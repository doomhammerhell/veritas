{
  "name": "veritas",
  "version": "0.5.0",
  "description": "Secure commit-reveal blind voting on StarkNet",
  "scripts": {
    "prepare": "husky install",
    "build": "scarb build",
    "test": "snforge test",
    "lint": "scarb fmt --check",
    "format": "scarb fmt",
    "build:frontend": "cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm start",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.cairo": [
      "scarb fmt"
    ]
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doomhammerhell/veritas.git"
  },
  "keywords": ["starknet", "cairo", "voting", "commit-reveal", "governance"],
  "license": "MIT"
}
