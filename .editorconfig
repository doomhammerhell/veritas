# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Cairo files
[*.cairo]
indent_style = space
indent_size = 4
max_line_length = 100

# JSON files
[*.json]
indent_style = space
indent_size = 2
max_line_length = 120

# YAML files
[*.yml]
[*.yaml]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown files
[*.md]
indent_style = space
indent_size = 2
max_line_length = 120
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
max_line_length = 100

# Docker files
[Dockerfile*]
indent_style = space
indent_size = 2
max_line_length = 120

# Configuration files
[*.toml]
indent_style = space
indent_size = 2
max_line_length = 120

# JavaScript/TypeScript files (for frontend)
[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2
max_line_length = 120

# CSS files
[*.css]
indent_style = space
indent_size = 2
max_line_length = 120

# HTML files
[*.html]
indent_style = space
indent_size = 2
max_line_length = 120
