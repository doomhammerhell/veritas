# Dockerfile for Monitoring Service
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache curl dumb-init ca-certificates

# Create non-root user
RUN addgroup -g 1001 -S veritas && \
    adduser -S veritas -u 1001 -G veritas

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy monitoring source
COPY --chown=veritas:veritas ./monitoring ./monitoring

# Switch to non-root user
USER veritas

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/monitoring/health || exit 1

# Environment variables
ENV NODE_ENV=production
ENV PORT=3001

# Start application
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "monitoring/server.js"]

# Labels
LABEL maintainer="Veritas Organization <dev@veritas.io>"
LABEL service="monitoring"
