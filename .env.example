# Environment Configuration Template

# Copy this file to .env and fill in your values

# Starknet Network Configuration
STARKNET_NETWORK=testnet
# STARKNET_NETWORK=mainnet

# Account Configuration (DO NOT commit real values)
STARKNET_ACCOUNT_ADDRESS=0x...
STARKNET_PRIVATE_KEY=0x...

# Contract Configuration
VOTING_DURATION=86400  # 24 hours in seconds
MAX_OPTIONS=5         # Maximum voting options

# Optional: RPC Configuration
STARKNET_RPC_URL=https://starknet-testnet.public.blastapi.io

# Optional: Explorer Configuration
STARKNET_EXPLORER=https://testnet.starkscan.co
