# StarkNet account for deployment (DO NOT commit real values)
STARKNET_ACCOUNT=~/.starkli-wallets/deployer/account.json
STARKNET_KEYSTORE=~/.starkli-wallets/deployer/keystore.json

# RPC endpoints
STARKNET_RPC_TESTNET=https://starknet-sepolia.public.blastapi.io/rpc/v0_7
STARKNET_RPC_MAINNET=https://starknet-mainnet.public.blastapi.io/rpc/v0_7

# Frontend config (set after deploy)
REACT_APP_CONTRACT_ADDRESS=0x...
REACT_APP_STARKNET_NETWORK=sepolia
